# ============================================
# COOLIFY ENVIRONMENT VARIABLES
# ============================================
# Copy these variables to your Coolify project's Environment Variables section
# Replace ALL placeholder values with your actual credentials
# ============================================

# ============================================
# 🔴 REQUIRED - YOU MUST CHANGE THESE
# ============================================

# AI Service API Keys (Get from respective platforms)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-ACTUAL-KEY-HERE
OPENAI_API_KEY=sk-proj-YOUR-ACTUAL-KEY-HERE
ELEVENLABS_API_KEY=sk_YOUR-ACTUAL-KEY-HERE

# Chatwoot Configuration (Get from your Chatwoot instance)
CHATWOOT_URL=https://chatwoot.astralsup.com
CHATWOOT_API_TOKEN=YOUR-CHATWOOT-TOKEN-HERE
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# Security Secrets (GENERATE STRONG RANDOM PASSWORDS!)
# Use: https://passwordsgenerator.net/ or run: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE-THIS-TO-A-STRONG-PASSWORD
JWT_SECRET=CHANGE-THIS-TO-A-32-CHAR-OR-LONGER-SECRET
SESSION_SECRET=CHANGE-THIS-TO-ANOTHER-STRONG-SECRET
ADMIN_PASSWORD=CHANGE-THIS-ADMIN-PASSWORD

# ============================================
# ⚪ OPTIONAL - Has Sensible Defaults
# ============================================

# Server Configuration
NODE_ENV=production
PORT=3000

# Agent Configuration (Customize your AI agent)
AGENT_NAME=Astral
BUSINESS_NAME=AstralSup
BUSINESS_DESCRIPTION=Empresa brasileira de atendimento ao cliente com inteligência artificial
BUSINESS_LANGUAGE=pt-BR

# AI Model Selection
CLAUDE_MODEL=claude-3-5-sonnet-20241022
ELEVENLABS_VOICE_ID=yoiZfrc4wQ9Rs1QGpnm5

# Message Handling Behavior
MESSAGE_BURST_DELAY_MS=3000
TYPING_SPEED_CPS=50
MAX_TYPING_INDICATOR_MS=10000

# Admin Dashboard Access
ADMIN_USERNAME=admin

# ============================================
# 🔵 AUTO-CONFIGURED - Don't Change
# ============================================
