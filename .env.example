# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Chatwoot Configuration
CHATWOOT_URL=https://your-chatwoot-instance.com
CHATWOOT_API_TOKEN=your-chatwoot-api-token
CHATWOOT_ACCOUNT_ID=your-account-id
CHATWOOT_INBOX_ID=your-whatsapp-inbox-id

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI Configuration (for Whisper speech-to-text)
OPENAI_API_KEY=your-openai-api-key

# ElevenLabs Configuration (for text-to-speech)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-portuguese-voice-id

# Agent Configuration
AGENT_NAME=Astral
BUSINESS_NAME=Your Business Name
BUSINESS_DESCRIPTION=Your business description
BUSINESS_LANGUAGE=pt-BR

# Message Handling
MESSAGE_BURST_DELAY_MS=3000
TYPING_SPEED_CPS=50
MAX_TYPING_INDICATOR_MS=10000

# WhatsApp Configuration
WHATSAPP_PHONE_NUMBER=your-whatsapp-number
