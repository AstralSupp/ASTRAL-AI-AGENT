# ============================================
# COOLIFY ENVIRONMENT VARIABLES
# ============================================
# This file uses Coolify's automatic variable generation
# Coolify will auto-generate values for SERVICE_PASSWORD_* and SERVICE_USER_* variables
# Copy these to your Coolify project's Environment Variables section
# ============================================

# ============================================
# 🔵 COOLIFY AUTO-GENERATED (Let Coolify create these)
# ============================================
# When you add these variables in Coolify, it will auto-generate secure values
# Just add the variable name, Coolify handles the rest

# Database credentials (Coolify auto-generates)
SERVICE_USER_POSTGRES=postgres
SERVICE_PASSWORD_POSTGRES=
SERVICE_PASSWORD_64_JWT=
SERVICE_PASSWORD_ADMIN=
SERVICE_PASSWORD_64_SESSION=

# Database name (optional, has default)
POSTGRES_DB=postgres

# ============================================
# 🔴 REQUIRED - YOU MUST SET THESE
# ============================================

# Chatwoot Configuration
CHATWOOT_URL=https://chatwoot.astralsup.com
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# AI Service API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ============================================
# ⚪ OPTIONAL - Has Sensible Defaults
# ============================================

# Server Configuration
NODE_ENV=production
PORT=3000

# Docker Image (use 'build' for local build, or your registry URL)
APP_IMAGE=

# Agent Configuration
AGENT_NAME=Astral
BUSINESS_NAME=AstralSup
BUSINESS_DESCRIPTION=Empresa brasileira de atendimento ao cliente com inteligência artificial
BUSINESS_LANGUAGE=pt-BR

# AI Configuration
CLAUDE_MODEL=claude-3-5-sonnet-20241022
ELEVENLABS_VOICE_ID=yoiZfrc4wQ9Rs1QGpnm5

# Message Handling
MESSAGE_BURST_DELAY_MS=3000
TYPING_SPEED_CPS=50
MAX_TYPING_INDICATOR_MS=10000

# Admin Dashboard
ADMIN_USERNAME=admin

# Supabase Keys (Internal - usually don't need to change)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# ============================================
# 📋 COOLIFY SETUP CHECKLIST
# ============================================
#
# 1. In Coolify, create new "Docker Compose" resource
# 2. Connect your Git repository
# 3. Set domain (e.g., ai-agent.astralsup.com)
# 4. In "Environment Variables" section, add:
#
#    SERVICE_PASSWORD_POSTGRES     (Coolify will generate)
#    SERVICE_PASSWORD_64_JWT       (Coolify will generate)
#    SERVICE_PASSWORD_ADMIN        (Coolify will generate)
#    SERVICE_PASSWORD_64_SESSION   (Coolify will generate)
#    CHATWOOT_URL                  (Set to your Chatwoot URL)
#    CHATWOOT_API_TOKEN            (From Chatwoot settings)
#    ANTHROPIC_API_KEY             (From Anthropic console)
#    OPENAI_API_KEY                (From OpenAI dashboard)
#    ELEVENLABS_API_KEY            (From ElevenLabs settings)
#
# 5. Deploy!
#
# ============================================
# 🚀 AFTER DEPLOYMENT
# ============================================
#
# Configure Chatwoot webhook:
# URL: https://YOUR-DOMAIN.com/webhook/chatwoot
# Event: message_created
#
# Access admin dashboard:
# https://YOUR-DOMAIN.com/admin/dashboard
#
# Health check:
# https://YOUR-DOMAIN.com/health
